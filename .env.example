# Copy this file to .env and paste the key. .env is gitignored.
#
# Get a key from https://aistudio.google.com/apikey
# The key must be on a PAID tier. The free tier carries request quotas far below
# what a 1081-task sweep needs, and free-tier traffic may be used for training,
# which is not acceptable for a benchmark that must stay uncontaminated.

GEMINI_API_KEY=

# Later arms. Not needed for the Google run.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# BASETEN_API_KEY=
